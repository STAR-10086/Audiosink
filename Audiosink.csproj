<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Native AOT 配置 -->
    <PublishAot>true</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <OptimizationPreference>Size</OptimizationPreference>

    <!-- WPF AOT 兼容性 -->
    <DirectPInvokeCalls>true</DirectPInvokeCalls>

    <!-- WinRT 映射配置 (Visual Studio 安装路径) -->
    <WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>

    <!-- 应用信息 -->
    <AssemblyName>Audiosink</AssemblyName>
    <RootNamespace>Audiosink</RootNamespace>
    <ApplicationIcon />
  </PropertyGroup>

  <!-- WinRT 映射配置 -->
  <PropertyGroup>
    <WindowsDesktopSdkVersion>9.0.0</WindowsDesktopSdkVersion>
  </PropertyGroup>

  <!-- 依赖包 -->
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.3" />
  </ItemGroup>


</Project>